<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Deploys a SQL Server .dacpac (an SSDT / Microsoft.Build.Sql database project) into the DbAiTest container through DacFx.</Description>
    <PackageId>DbAiTest.MsSql.Dacpac</PackageId>
    <RootNamespace>DbAiTest.MsSql.Dacpac</RootNamespace>
    <PackageTags>$(PackageTags);dacpac;dacfx;ssdt;sqlproj</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SqlServer.DacFx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbAiTest.MsSql\DbAiTest.MsSql.csproj" />
  </ItemGroup>

</Project>
