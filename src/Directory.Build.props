<Project>

  <!-- Everything under src/ ships to nuget.org. The repository-wide settings come first. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFrameworks>$(DbTestTargetFrameworks)</TargetFrameworks>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <Product>DbTest</Product>
    <Authors>dbaitest</Authors>
    <Company>dbaitest</Company>
    <Copyright>Copyright (c) dbaitest contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/dbaitest/db-test</RepositoryUrl>
    <PackageProjectUrl>https://dbaitest.com/db-test/</PackageProjectUrl>
    <PackageReleaseNotes>https://github.com/dbaitest/db-test/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PackageTags>dotnet;database;testing;integration-tests;testcontainers;sqlserver;postgresql;mysql;mstest</PackageTags>
    <!-- The README ships inside the package, so nuget.org shows it on the package page. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!--
    The release version is not edited by hand: the Publish workflow passes -p:Version from
    the release tag. PackageValidationBaselineVersion names the last release, which package
    validation compares the public API against; raise it after each release.

    A local or CI build is <baseline>-dev. Its assembly version then equals the baseline's,
    which package validation requires (CP0003: an assembly version may not go below the
    baseline's), and nothing but the baseline holds a version number.
  -->
  <PropertyGroup>
    <PackageValidationBaselineVersion>0.3.0</PackageValidationBaselineVersion>
    <VersionPrefix>$(PackageValidationBaselineVersion)</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
  </PropertyGroup>

  <!--
    Debuggability. Source Link (built into the .NET 8+ SDK) maps the PDBs to the GitHub
    sources; the symbols ship as a .snupkg next to each package; a CI build normalises paths
    so the same commit produces the same binaries anywhere.
  -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    Package validation checks that every target framework exposes a compatible API surface,
    and that the public API stays compatible with the baseline release on nuget.org (see the
    version block above). A deliberate breaking change raises the baseline in the same pull
    request.
  -->
  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- The unit tests reach the internals (scalar conversion, CLI argument parsing). -->
  <ItemGroup>
    <InternalsVisibleTo Include="DbTest.Core.Tests" />
  </ItemGroup>

</Project>
