<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>MSTest integration for DbTest: a base class that shares one container per engine across the run, checks the shape guard after every test and records per-test timings.</Description>
    <PackageId>DbTest.MSTest</PackageId>
    <RootNamespace>DbTest.MSTest</RootNamespace>
    <PackageTags>$(PackageTags);mstest</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The framework only: the consuming test project brings the adapter and test SDK. -->
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbTest.Core\DbTest.Core.csproj" />
  </ItemGroup>

</Project>
