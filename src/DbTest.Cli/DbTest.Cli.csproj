<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(DbTestTargetFrameworks)</TargetFrameworks>
    <Description>Command line front end for DbTest: start a container, apply a schema, report on it.</Description>
    <IsPackable>true</IsPackable>
    <PackageId>DbTest.Cli</PackageId>
    <RootNamespace>DbTest.Cli</RootNamespace>
    <AssemblyName>dbtest</AssemblyName>
    <ToolCommandName>dbtest</ToolCommandName>
    <PackAsTool>true</PackAsTool>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DbTest.Core\DbTest.Core.csproj" />
    <ProjectReference Include="..\DbTest.MsSql\DbTest.MsSql.csproj" />
    <ProjectReference Include="..\DbTest.MySql\DbTest.MySql.csproj" />
    <ProjectReference Include="..\DbTest.PostgreSql\DbTest.PostgreSql.csproj" />
  </ItemGroup>

</Project>
