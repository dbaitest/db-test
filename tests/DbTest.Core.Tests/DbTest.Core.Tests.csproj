<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests: no container, no Docker. They run on every OS in CI and fail fast when the
    splitting, conversion, loading or guarding rules regress.
  -->
  <PropertyGroup>
    <TargetFrameworks>$(DbTestTargetFrameworks)</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <RootNamespace>DbTest.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DbTest.Core\DbTest.Core.csproj" />
    <ProjectReference Include="..\..\src\DbTest.Cli\DbTest.Cli.csproj" />
    <ProjectReference Include="..\..\src\DbTest.MSTest\DbTest.MSTest.csproj" />
    <ProjectReference Include="..\..\src\DbTest.MsSql.Dacpac\DbTest.MsSql.Dacpac.csproj" />
  </ItemGroup>

</Project>
