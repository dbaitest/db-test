# Normalize line endings in the repository. The CI runs on Linux and the SQL parser
# splits on LF, so a CRLF checkout would change how a file is tokenized.
* text=auto eol=lf

*.cs      text diff=csharp
*.csproj  text
*.sln     text
*.props   text
*.config  text
*.yml     text
*.md      text
*.sql     text
*.psql    text

# Binary
*.dll     binary
*.pdb     binary
*.png     binary
*.jpg     binary
*.zip     binary
