<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Globalization invariant mode is deliberately NOT enabled: Microsoft.Data.SqlClient
      refuses to run under it ("Globalization Invariant Mode is not supported"), so the SQL
      Server engine would fail at the first connection.
    -->
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <NoWarn>$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Product>DbTest</Product>
    <Authors>dbaitest</Authors>
    <Company>dbaitest</Company>
    <Copyright>Copyright (c) dbaitest contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <!--
    The supported runtime range. net8.0 is the floor: every package ships a net8.0 asset,
    so a consumer on .NET 8 or on any newer runtime resolves an asset that fits. Each
    project targets every framework in this list, so the libraries are compiled — and the
    suites are run — against every one of them.

    Adding a framework here means: a matching runtime in the CI matrix, a matching entry
    in the README requirements, and a build that needs an SDK new enough to target it.
  -->
  <PropertyGroup>
    <DbTestTargetFrameworks>net8.0;net9.0;net10.0</DbTestTargetFrameworks>
  </PropertyGroup>

  <!--
    Roll-forward for the executables this repository produces (the CLI and the test host).
    A net8.0 build must also run on .NET 9, 10, 11 and later when the floor runtime is
    not installed. "Major" keeps the floor when it is there and moves up to the next
    available major version when it is not — so a machine with only .NET 10 still runs
    the suite, and a machine with .NET 8 still runs it on .NET 8.
  -->
  <PropertyGroup>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <!--
    net8.0 and net9.0 are past their support window; the floor is a deliberate choice,
    not an accident, so the EOL warning is not useful here.
  -->
  <PropertyGroup>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>

</Project>
