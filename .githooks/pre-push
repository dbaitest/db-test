#!/usr/bin/env bash
#
# Blocks a direct push to a protected branch.
#
# GitHub rejects it anyway; this hook makes the failure happen before the push,
# with a message that says what to do instead.
#
# Enable it once per clone:
#     git config core.hooksPath .githooks
#
set -euo pipefail

protected_branch="${DBTEST_PROTECTED_BRANCH:-main}"
remote_name="$1"
url="$2"

# Find the branch being pushed. It is the ref after the local ref.
pushing_to_main=0
while read -r _local_ref _local_sha _remote_ref _remote_sha; do
    case "$_remote_ref" in
        "refs/heads/$protected_branch")
            pushing_to_main=1
            ;;
    esac
done

if [ "$pushing_to_main" -eq 0 ]; then
    exit 0
fi

cat >&2 <<EOF
Direct pushes to '$protected_branch' are blocked. This repository requires every
change to go through a pull request.

Do this instead:

    git switch -c feature/short-description
    # ...make your change...
    git add -A
    git commit -m "feat(scope): what you changed"
    git push -u origin feature/short-description

Then open the pull request:

    gh pr create --base $protected_branch --fill

A pull request needs one approving review from a code owner before it merges, so
ask the other maintainer to look at it.

If this is a fork, push the branch to your fork and open the pull request from
there instead.
EOF

exit 1
