<Project>

  <!--
    Samples build against the repository's own projects (ProjectReference), so they compile and
    run against the code in this commit. They are never packed or published: every sample
    project also says IsPackable=false itself, and samples/ is not part of DbTest.sln, which is
    what the release workflow builds and packs.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Sample tests are documented by their names, like the repository's own tests. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
