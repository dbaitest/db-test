<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Sample.Database.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <!--
    In your own project these are package references instead:
      dotnet add package DbAiTest.MSTest
      dotnet add package DbAiTest.MsSql.Dacpac
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\DbAiTest.MSTest\DbAiTest.MSTest.csproj" />
    <ProjectReference Include="..\..\..\src\DbAiTest.MsSql.Dacpac\DbAiTest.MsSql.Dacpac.csproj" />
  </ItemGroup>

  <!-- The application code under test: repositories that know nothing about DbAiTest. -->
  <ItemGroup>
    <ProjectReference Include="..\Sample.Shop\Sample.Shop.csproj" />
  </ItemGroup>

  <!--
    The database project. Referencing it makes `dotnet build` / `dotnet test` build the .dacpac
    first; it is not an assembly, so nothing is referenced or copied by the reference itself.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Sample.Database\Sample.Database.sqlproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      Private="false" />
  </ItemGroup>

  <!--
    Copy each referenced database project's .dacpac next to the test binaries, together with
    every .dacpac beside it: the dacpacs it references (master.dacpac, another project's) are
    resolved from the folder it is deployed from.
  -->
  <Target Name="CopyDacpacs" AfterTargets="Build">
    <MSBuild Projects="@(ProjectReference)"
             Condition="'%(Extension)' == '.sqlproj'"
             Targets="GetTargetPath"
             BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_DatabaseProjectDacpac" />
    </MSBuild>
    <ItemGroup>
      <_DacpacToCopy Include="%(_DatabaseProjectDacpac.RootDir)%(_DatabaseProjectDacpac.Directory)*.dacpac" />
    </ItemGroup>
    <Copy SourceFiles="@(_DacpacToCopy)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- The project's own post-deployment script, re-run by the tests after each clean. -->
  <ItemGroup>
    <None Include="..\Sample.Database\Script.PostDeployment.sql"
          Link="Script.PostDeployment.sql"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Test data: SQL scripts and JSON data files loaded by Fixtures/ShopFixtures.cs. -->
  <ItemGroup>
    <None Include="Fixtures\*.sql;Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
