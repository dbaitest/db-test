<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Stands in for an application's data layer: plain repositories over Sample.Database, built on
    a connection factory and nothing test-specific. Sample.Database.Tests points them at the
    throwaway container unchanged.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Sample.Shop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

</Project>
