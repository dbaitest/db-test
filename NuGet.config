<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    This is an open-source repository: it must restore from public feeds only.
    The machine-level config on some workstations also carries a private Azure DevOps
    feed (PMI); leaving it enabled here leaks internal package metadata into public
    restores and produces NU1900 warnings. <clear /> drops inherited sources.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
